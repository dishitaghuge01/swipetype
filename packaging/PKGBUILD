pkgver() {
  cd "$srcdir/swipetype"
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

check() {
  cd "$srcdir/swipetype"
  # Standard-library tests only: no GTK, touchpad, desktop session or Node needed.
  /usr/bin/python -m unittest discover -s tests -p 'test_*.py' -v
}

package_swipetype-git() {
  pkgdesc='System-wide touchpad swipe-to-text daemon for Linux (X11/Wayland)'
  depends=('python>=3.10' 'python-evdev>=2.0' 'python-yaml' 'python-wordfreq>=3.1.1')
  optdepends=('ydotool: required injection backend for Wayland; configure ydotoold separately'
              'xdotool: required injection backend for X11'
              'swipetype-overlay-git: optional live ghost keyboard and trace')
  backup=('usr/share/swipetype/config.yaml')

  local module
  for module in capture decoder gesture inject overlay; do
    install -dm755 "$pkgdir/usr/share/swipetype/$module"
    install -m644 "$srcdir/swipetype/$module/"*.py "$pkgdir/usr/share/swipetype/$module/"
  done
  install -Dm644 "$srcdir/swipetype/cli/swipetype_toggle.py" \
    "$pkgdir/usr/share/swipetype/cli/swipetype_toggle.py"
  install -m644 "$srcdir/swipetype/"{daemon.py,config.py,config.yaml} "$pkgdir/usr/share/swipetype/"
  install -Dm755 "$srcdir/swipetype-daemon" "$pkgdir/usr/bin/swipetype-daemon"
  install -Dm755 "$srcdir/swipetype-toggle" "$pkgdir/usr/bin/swipetype-toggle"
  install -Dm644 "$srcdir/swipetype.service" "$pkgdir/usr/lib/systemd/user/swipetype.service"
  install -Dm644 "$srcdir/swipetype/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

package_swipetype-overlay-git() {
  pkgdesc='Optional SwipeType WebKitGTK overlay for layer-shell compositors (Sway/Hyprland/river/labwc)'
  depends=('swipetype-git' 'python>=3.10' 'python-gobject' 'python-cairo' 'python-yaml'
           'gtk4' 'gtk4-layer-shell' 'webkitgtk-6.0' 'systemd')

  install -Dm644 "$srcdir/swipetype/overlay-app/swipetype_overlay.py" \
    "$pkgdir/usr/share/swipetype-overlay/swipetype_overlay.py"
  install -m644 "$srcdir/swipetype/cli/swipetype_overlay_toggle.py" \
    "$pkgdir/usr/share/swipetype-overlay/swipetype_overlay_toggle.py"
  cp -r "$srcdir/swipetype/overlay-app/ui" "$pkgdir/usr/share/swipetype-overlay/ui"
  find "$pkgdir/usr/share/swipetype-overlay/ui" -type d -exec chmod 755 {} +
  find "$pkgdir/usr/share/swipetype-overlay/ui" -type f -exec chmod 644 {} +
  install -Dm755 "$srcdir/swipetype-overlay" "$pkgdir/usr/bin/swipetype-overlay"
  install -Dm755 "$srcdir/swipetype-overlay-toggle" "$pkgdir/usr/bin/swipetype-overlay-toggle"
  install -Dm644 "$srcdir/swipetype-overlay.service" \
    "$pkgdir/usr/lib/systemd/user/swipetype-overlay.service"
  install -Dm644 "$srcdir/dev.dishitaghuge.swipetype.overlay.desktop" \
    "$pkgdir/usr/share/applications/dev.dishitaghuge.swipetype.overlay.desktop"
  install -Dm644 "$srcdir/swipetype/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
