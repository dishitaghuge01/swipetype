pkgname = swipetype-git
	pkgdesc = System-wide touchpad swipe-to-text daemon for Linux (X11/Wayland)
	depends = python>=3.10
	depends = python-evdev>=2.0
	depends = python-yaml
	depends = python-wordfreq>=3.1.1
	optdepends = ydotool: required injection backend for Wayland; configure ydotoold separately
	optdepends = xdotool: required injection backend for X11
	optdepends = swipetype-overlay-git: optional live ghost keyboard and trace
	backup = usr/share/swipetype/config.yaml

pkgname = swipetype-overlay-git
	pkgdesc = Optional SwipeType WebKitGTK overlay for layer-shell compositors (Sway/Hyprland/river/labwc)
	depends = swipetype-git
	depends = python>=3.10
	depends = python-gobject
	depends = python-cairo
	depends = python-yaml
	depends = gtk4
	depends = gtk4-layer-shell
	depends = webkitgtk-6.0
	depends = systemd
